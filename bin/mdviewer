#!/usr/bin/env bash

# MDViewer Launcher Script

# Resolve symlink to locate the real project root directory
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")/.." >/dev/null 2>&1 && pwd)"

ELECTRON_BIN="$SCRIPT_DIR/node_modules/electron/dist/electron"

# Run Electron directly if binary is present (fastest & bypasses npx overhead)
if [ -x "$ELECTRON_BIN" ]; then
    exec "$ELECTRON_BIN" "$SCRIPT_DIR" "$@"
fi

# Fallback: check node_modules/.bin/electron
if [ -x "$SCRIPT_DIR/node_modules/.bin/electron" ]; then
    exec "$SCRIPT_DIR/node_modules/.bin/electron" "$SCRIPT_DIR" "$@"
fi

# Check if node & npm are available as fallback
if ! command -v node &> /dev/null; then
    echo "Erro: Node.js não foi encontrado no PATH."
    exit 1
fi

# Fallback to npx inside project directory
exec npx --prefix "$SCRIPT_DIR" electron "$SCRIPT_DIR" "$@"
